{
  "id": "ash",
  "name": "Ash",
  "version": "6.0.0",
  "api": 6,
  "description": "A general assistant that reads, writes and runs things on your computer.",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": [
    "chat",
    "productivity"
  ],
  "payment": "free",
  "environment": {
    "kind": "process"
  },
  "agent": {
    "name": "Ash",
    "model": {
      "kind": "chat",
      "tools": true
    },
    "prompt": [
      "prompt/system.md"
    ],
    "tools": [
      "read",
      "write",
      "edit",
      "find",
      "grep",
      "bash",
      "bash_wait",
      "exec",
      "exec_wait",
      "generate",
      "spawn_agent",
      "message_agent",
      "wait_agents",
      "stop_agent",
      "ask",
      "tool_search",
      "tool_call"
    ],
    "roots": [
      "home",
      "workspace",
      "memory"
    ],
    "skills": [
      "skills"
    ],
    "projects": true
  },
  "recommends": [
    "browser"
  ],
  "uses": [
    "sessions",
    "store"
  ],
  "surfaces": [
    {
      "id": "main",
      "kind": "view",
      "title": "Ash",
      "placements": [
        "rail"
      ],
      "entry": "views/ash.js"
    }
  ]
}
