{
  "id": "ash",
  "name": "Ash",
  "version": "6.2.3",
  "api": 7,
  "description": "A general assistant that reads, writes and runs things on your device.",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": [
    "chat",
    "productivity"
  ],
  "payment": "free",
  "environment": {
    "kind": "process"
  },
  "agent": {
    "name": "Ash",
    "model": {
      "kind": "chat",
      "tools": true
    },
    "prompt": [
      "prompt/system.md"
    ],
    "tools": [
      "read",
      "write",
      "edit",
      "find",
      "grep",
      "file_search",
      "bash",
      "bash_wait",
      "python",
      "exec",
      "exec_wait",
      "generate",
      "spawn_agent",
      "message_agent",
      "wait_agents",
      "stop_agent",
      "ask",
      "tool_search",
      "tool_call"
    ],
    "roots": [
      "home",
      "workspace",
      "memory"
    ],
    "skills": [
      "skills"
    ],
    "budget": {
      "tokens": 2000000,
      "rounds": 120
    },
    "projects": true
  },
  "agents": {
    "researcher": {
      "name": "Researcher",
      "description": "Answers one sub-question of a deep research from web pages, saves each page it reads and writes its findings with quotes.",
      "model": {
        "kind": "chat",
        "tools": true
      },
      "prompt": [
        "prompt/researcher.md"
      ],
      "tools": [
        "read",
        "write",
        "find",
        "grep",
        "exec",
        "exec_wait"
      ],
      "roots": [
        "workspace"
      ],
      "skills": [
        "skills"
      ],
      "budget": {
        "tokens": 300000,
        "rounds": 12
      }
    }
  },
  "recommends": [
    "browser"
  ],
  "uses": [
    "sessions",
    "store",
    "files.open"
  ],
  "surfaces": [
    {
      "id": "main",
      "kind": "view",
      "title": "Ash",
      "placements": [
        "rail"
      ],
      "entry": "views/ash.js"
    },
    {
      "id": "sheet",
      "kind": "view",
      "title": "Ash",
      "placements": [
        "modal"
      ],
      "entry": "views/sheet.js"
    }
  ]
}
